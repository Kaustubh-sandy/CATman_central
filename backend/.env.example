# Server Configuration
PORT=8000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# MQTT (must match the broker the machine simulator publishes to)
MQTT_URL=mqtt://localhost:1883
HEARTBEAT_STALE_SEC=10
HEARTBEAT_OFFLINE_SEC=20

# Pre-check / safety timings
PRECHECK_TIMEOUT_MS=5000
PRECHECK_MANUAL_TIMEOUT_MS=600000
ALERT_ESCALATION_MS=15000
IDLE_LESSON_AFTER_SEC=180
FUEL_PRICE_INR=95

# Task ETA model (src/ml/eta/predict.py). ETA_PYTHON must have pandas, scikit-learn, joblib, shap.
ETA_ENABLED=true
ETA_PYTHON=python
ETA_INTERVAL_MS=15000
ETA_TIMEOUT_MS=30000

# Firebase web config (Project settings → General → Your apps).
# Leave empty to run in-memory only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Gemini (AI assistant). Leave empty to use offline keyword mode.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
